# Copy to .env.local for development. Set the same names in Vercel for production.
# Never commit real values.

# Production URL, no trailing slash (used for metadata, sitemap and links in emails)
NEXT_PUBLIC_SITE_URL=

# Recon Call booking link and provider: "calendly" or "cal"
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_BOOKING_PROVIDER=

# Resend (email the Leak Report). Server only.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Player Two Growth House <reports@yourdomain>
EMAIL_FROM=
# Team inbox that receives a copy of every emailed report
LEADS_TO_EMAIL=
